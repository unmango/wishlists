{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>UnstoppableMango/renovate-config",
    "github>UnstoppableMango/renovate-config:release-please"
  ],
  "nix": {
    "enabled": true
  },
  "packageRules": [
    {
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "matchCurrentVersion": "!/^0/",
      "automerge": true
    },
    {
      "description": "Move the .NET Docker images with the SDK and packages, so a .NET major is one PR",
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "mcr.microsoft.com/dotnet/**"
      ],
      "groupName": "dotnet monorepo"
    }
  ],
  "gitIgnoredAuthors": [
    "98929874+thecluster-bot[bot]@users.noreply.github.com"
  ]
}
